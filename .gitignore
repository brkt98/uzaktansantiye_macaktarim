# ============================================================
# GEÇİCİ DURUM: "her şey paylaşımlı".
# Sadece (1) bağımlılıklar, (2) build/üretilen çıktılar ve
# (3) sırlar ignore ediliyor. Geri kalan HER ŞEY paylaşılıyor.
# (Detaylı ayar sonra yapılacak.)
# ============================================================

# === Bağımlılıklar (paylaşılmaz — her makinede 'npm install' ile kurulur) ===
/node_modules
/.pnp
.pnp.*
.yarn/*

# === Build / üretilen çıktılar (paylaşılmaz — 'npm run build' ile üretilir) ===
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo
/coverage

# === Native build çıktıları (paylaşılmaz — 'npx cap sync' ile üretilir) ===
/ios/App/App/public
/ios/App/Pods
/ios/DerivedData
/android/app/build
/android/build
/android/.gradle

# === Sırlar (GÜVENLİK: repoya ASLA girmemeli — şu an bu dosyalar zaten yok) ===
.env
.env*.local
.env.production
*.pem
*.key
*.p8
*.p12
*.pfx
*.keystore
*.jks
keystore.properties
key.properties
GoogleService-Info.plist
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
*secret*.json
*credentials*.json
secrets.*

# NOT: .DS_Store, .vscode, .idea, capacitor.config.json, public/uploads,
# loglar vb. artık BİLEREK paylaşılıyor (ignore edilmiyor).
