# Android — sadece build çıktıları ve imzalama anahtarları ignore edilir.
# Geri kalan HER ŞEY (capacitor.config.json dahil) paylaşılır.

# === Build çıktıları (paylaşılmaz) ===
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class
bin/
gen/
out/
.gradle/
build/
captures/
.navigation/
.externalNativeBuild
.cxx/
*.hprof
proguard/

# Local configuration file (sdk path, etc) — makineye özel
local.properties

# === İmzalama anahtarları — GÜVENLİK: ASLA commit edilmez ===
*.jks
*.keystore
key.properties

# Cordova plugins for Capacitor (üretilen)
capacitor-cordova-android-plugins

# Copied web assets (üretilen)
app/src/main/assets/public

# NOT: capacitor.config.json, capacitor.plugins.json ve config.xml
# artık BİLEREK paylaşılıyor.
